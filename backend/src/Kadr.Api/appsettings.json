{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "kadr",
    "Audience": "kadr-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "PlatformAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "Platform Owner"
  },
  "Cors": {
    "Origins": []
  },
  "Auth": {
    "CrossSiteCookies": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "WebPush": {
    "Enabled": false,
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "Subject": "",
    "AllowedEndpointHosts": []
  },
  "App": {
    "PublicWebBaseUrl": ""
  },
  "RateLimiting": {
    "RegisterPermitLimit": 5,
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "VerifyPermitLimit": 10,
    "ResendPermitLimit": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kadr-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
